{
    "manufacturer": "Mutahhar Sulgan",
    "keyboard_name": "voidboard",
    "maintainer": "mdmutahhar24-pixel",
    "bootloader": "rp2040",
    "diode_direction": "ROW2COL",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true,
        "oled": true
    },
    "matrix_pins": {
        "cols": ["GP3", "GP6", "GP10"],
        "rows": ["GP0", "GP1", "GP2"]
    },
    "processor": "RP2040",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "encoder": {
        "rotary": [
            {
                "pin_a": "GP9",
                "pin_b" : "GP8"
            }
        ]
    },
    "i2c": {
        "driver": "vendor",
        "sda_pin": "GP5",
        "scl_pin": "GP4"
    },
    "layouts": {
        "LAYOUT_ortho_3x3": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2}
            ]
        }
    }
}
